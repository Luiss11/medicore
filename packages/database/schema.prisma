// ─────────────────────────────────────────────────────────────────
// MediCore — Prisma Schema
// Multi-tenant, universal medical platform
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════

enum Plan {
  STARTER    // Free: 1 doctor, 50 patients
  PRO        // $299 MXN/mo: 1 doctor unlimited
  CLINIC     // $799 MXN/mo: 5 doctors
  ENTERPRISE // Custom
}

enum UserRole {
  SUPER_ADMIN   // Platform owner
  TENANT_ADMIN  // Clinic owner/admin
  DOCTOR
  RECEPTIONIST
  NURSE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  INSURANCE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum InventoryCategory {
  MEDICATION
  CONSUMABLE
  EQUIPMENT
  OFFICE
  OTHER
}

enum PluginStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

// ════════════════════════════════════════════
// PLATFORM — Tenant Management
// ════════════════════════════════════════════

model Tenant {
  id          String    @id @default(cuid())
  name        String                          // "Clínica Sonrisa"
  slug        String    @unique               // "clinica-sonrisa" → URL
  plan        Plan      @default(STARTER)
  logoUrl     String?
  primaryColor String?  @default("#0a7ea4")
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  country     String    @default("MX")
  timezone    String    @default("America/Mexico_City")
  currency    String    @default("MXN")
  taxId       String?                         // RFC en México
  isActive    Boolean   @default(true)
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  users        User[]
  doctors      Doctor[]
  patients     Patient[]
  appointments Appointment[]
  treatments   Treatment[]
  payments     Payment[]
  inventory    InventoryItem[]
  plugins      TenantPlugin[]
  auditLogs    AuditLog[]
  subscription Subscription?

  @@index([slug])
  @@map("tenants")
}

// Which specialty plugins are active per tenant
model TenantPlugin {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pluginKey String                            // "odontologia" | "oftalmologia" | etc.
  status    PluginStatus @default(ACTIVE)
  config    Json?                             // Plugin-specific settings
  activatedAt DateTime   @default(now())

  @@unique([tenantId, pluginKey])
  @@map("tenant_plugins")
}

// ════════════════════════════════════════════
// AUTH — Users & Sessions
// ════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String
  role         UserRole  @default(RECEPTIONIST)
  avatarUrl    String?
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // If user IS a doctor, link to doctor profile
  doctorProfile Doctor?
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@unique([email, tenantId])  // Same email can exist in different tenants
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

// ════════════════════════════════════════════
// CORE — Doctors
// ════════════════════════════════════════════

model Doctor {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id])
  firstName         String
  lastName          String
  specialty         String
  cedula            String?                   // Cédula profesional
  bio               String?
  photoUrl          String?
  phone             String?
  email             String?
  consultationPrice Decimal? @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointments Appointment[]
  clinicalNotes ClinicalNote[]
  schedules    DoctorSchedule[]

  @@index([tenantId])
  @@map("doctors")
}

// Doctor availability schedule
model DoctorSchedule {
  id         String  @id @default(cuid())
  doctorId   String
  doctor     Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek  Int                              // 0=Sun, 1=Mon, ..., 6=Sat
  startTime  String                           // "09:00"
  endTime    String                           // "18:00"
  slotMinutes Int    @default(30)            // Appointment slot duration
  isActive   Boolean @default(true)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

// ════════════════════════════════════════════
// CORE — Patients
// ════════════════════════════════════════════

model Patient {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Identity
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  gender        Gender    @default(PREFER_NOT_TO_SAY)
  photoUrl      String?
  // Contact
  phone         String?
  email         String?
  address       String?
  city          String?
  emergencyContact     String?
  emergencyContactPhone String?
  // Medical
  bloodType     BloodType @default(UNKNOWN)
  allergies     String?
  chronicConditions String?
  currentMedications  String?
  notes         String?
  // Meta
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments  Appointment[]
  clinicalNotes ClinicalNote[]
  payments      Payment[]
  // Plugin data
  odontogramRecords OdontogramRecord[]

  @@index([tenantId])
  @@index([tenantId, lastName])  // Fast search by last name
  @@map("patients")
}

// ════════════════════════════════════════════
// CORE — Appointments
// ════════════════════════════════════════════

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  scheduledAt DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  treatments  AppointmentTreatment[]
  payment     Payment?
  clinicalNote ClinicalNote?

  @@index([tenantId])
  @@index([tenantId, doctorId, scheduledAt])  // Calendar queries
  @@index([tenantId, patientId])
  @@map("appointments")
}

// ════════════════════════════════════════════
// CORE — Treatments (Catalog per tenant)
// ════════════════════════════════════════════

model Treatment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  category     String?                       // "Preventivo", "Correctivo", etc.
  basePrice    Decimal  @db.Decimal(10, 2)
  durationMin  Int      @default(30)
  pluginKey    String?                       // If null → universal; else → specialty-specific
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointmentTreatments AppointmentTreatment[]

  @@index([tenantId])
  @@map("treatments")
}

// Pivot: treatments applied in a specific appointment
model AppointmentTreatment {
  id            String   @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  treatmentId   String
  treatment     Treatment   @relation(fields: [treatmentId], references: [id])
  appliedPrice  Decimal  @db.Decimal(10, 2)
  quantity      Int      @default(1)
  notes         String?

  @@unique([appointmentId, treatmentId])
  @@map("appointment_treatments")
}

// ════════════════════════════════════════════
// CORE — Clinical Notes (SOAP format)
// ════════════════════════════════════════════

model ClinicalNote {
  id            String   @id @default(cuid())
  tenantId      String
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor   @relation(fields: [doctorId], references: [id])
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  // SOAP
  subjective    String?                       // What patient says
  objective     String?                       // Clinical findings
  assessment    String?                       // Diagnosis
  plan          String?                       // Treatment plan
  // Extra
  vitalSigns    Json?                         // { bp: "120/80", hr: 72, temp: 36.5 }
  attachments   Json?                         // [{ url, name, type }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
  @@map("clinical_notes")
}

// ════════════════════════════════════════════
// CORE — Payments
// ════════════════════════════════════════════

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  discount      Decimal       @db.Decimal(10, 2) @default(0)
  total         Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(CASH)
  reference     String?                       // Receipt / transaction number
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@map("payments")
}

// ════════════════════════════════════════════
// CORE — Inventory
// ════════════════════════════════════════════

model InventoryItem {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  category     InventoryCategory @default(CONSUMABLE)
  sku          String?
  quantity     Int               @default(0)
  minQuantity  Int               @default(5)            // Alert threshold
  unit         String            @default("pza")        // pza, caja, ml, etc.
  unitPrice    Decimal           @db.Decimal(10, 2)
  supplier     String?
  expiresAt    DateTime?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  movements InventoryMovement[]

  @@index([tenantId])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String                               // "IN" | "OUT" | "ADJUSTMENT"
  quantity    Int
  reason      String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([itemId])
  @@map("inventory_movements")
}

// ════════════════════════════════════════════
// PLUGIN — Odontología (Dental)
// ════════════════════════════════════════════

model OdontogramRecord {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber Int                              // 1-32 (FDI or Universal notation)
  surface     String?                          // "M", "D", "O", "V", "L", or combinations
  condition   String                           // "caries", "obturado", "extraccion", "corona", etc.
  material    String?                          // "amalgama", "resina", etc.
  notes       String?
  recordedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@map("odontogram_records")
}

// ════════════════════════════════════════════
// PLATFORM — Subscriptions & Billing
// ════════════════════════════════════════════

model Subscription {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             Plan
  status           String                          // "active" | "past_due" | "cancelled"
  stripeSubId      String?                         // Stripe subscription ID
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("subscriptions")
}

// ════════════════════════════════════════════
// PLATFORM — Audit Log
// ════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String                                // "patient.create" | "appointment.cancel" etc.
  resource   String                                // "Patient" | "Appointment" etc.
  resourceId String?
  metadata   Json?                                 // Before/after state
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@map("audit_logs")
}
